:root {
  --primary-bg: #f8f1e7;
  --secondary-bg: #efe3d1;

  --gold: #b89562;
  --gold-dark: #8f6b3e;

  --text-dark: #3d342d;
  --text-light: #6d6258;

  --white: #ffffff;

  --radius: 18px;

  --shadow:
    0 5px 15px rgba(0,0,0,.08);

  --transition: all .3s ease;
}

body {
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  background: var(--primary-bg);
  color: var(--text-dark);
}

.section-padding{
  padding:80px 0;
}

.btn-gold{
  background:var(--gold);
  border:none;
  color:white;
  padding:12px 25px;
  border-radius:8px;
}

.btn-gold:hover{
  background:var(--gold-dark);
}

.custom-navbar{
    background:#efe3d1;
    padding:18px 0;
}

.logo{
    font-size:30px;
    font-weight:700;
    color:#8f6b3e !important;
}

.nav-link{
    color:#4f4338 !important;
    margin-left:20px;
    text-transform:uppercase;
    font-size:14px;
    letter-spacing:1px;
}
.hero-section{
    padding:60px 0;
}

.gallery-main,
.gallery-img{
    width:100%;
    border-radius:20px;
    object-fit:cover;
    box-shadow:var(--shadow);
}

.gallery-main{
    height:420px;
}

.gallery-img{
    height:320px;
    margin-top: 60px;
    object-fit: contain;
}

.hero-content{
    text-align:center;
    margin-top:50px;
}

.hero-content h1{
    font-size:60px;
    line-height:1.1;
    margin-bottom:20px;
}

.hero-content p{
    max-width:700px;
    margin:auto;
    color:var(--text-light);
}

.btn-wrapper{
    display:flex;
    gap:15px;
    justify-content:center;
    margin-top:25px;
    flex-wrap:wrap;
}

.product-card{
    background:white;
    padding:15px;
    border-radius:18px;
    text-align:center;
    box-shadow:var(--shadow);
}

.product-img{
    width:100%;
    height:250px;
    object-fit:cover;
    border-radius:15px;
}

.product-card h5{
    margin-top:15px;
}

.product-card p{
    color:var(--text-light);
}

@media(max-width:768px){

.hero-content h1{
    font-size:38px;
}

.gallery-main{
    height:300px;
}

.gallery-img{
    height:220px;
}
}